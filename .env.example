# AWS S3
AWS_ACCESS_KEY_ID=replace-with-your-access-key-id
AWS_SECRET_ACCESS_KEY=replace-with-your-secret-access-key
# AWS_SESSION_TOKEN=replace-with-session-token
AWS_REGION=ap-southeast-2
S3_BUCKET=replace-with-your-s3-bucket

# PostgreSQL and application ports
POSTGRES_DB=sla
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
BACKEND_PORT=8080
FRONTEND_PORT=80

# Frontend API URL. Use /api with the Docker Compose Nginx proxy.
VITE_API_URL=/api

# Outbox worker
OUTBOX_POLL_INTERVAL_SECONDS=5
OUTBOX_CLAIM_TIMEOUT_SECONDS=300
OUTBOX_BATCH_SIZE=500
OUTBOX_S3_BATCH_SIZE=500
OUTBOX_LOG_INTERVAL=100
